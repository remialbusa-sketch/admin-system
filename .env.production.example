# =============================================================================
# MCBTSi Admin System — PRODUCTION environment template (cPanel, mcbtsi.com)
# =============================================================================
# Copy to .env on the server and fill in real values. NEVER commit .env.
#   ssh:  cp .env.production.example .env  &&  php artisan key:generate
# See docs/monday-integration-and-cpanel-deployment.md §B6 for the full matrix.

APP_NAME="Admin System"
APP_ENV=production
APP_KEY=                                    # php artisan key:generate on the server
APP_DEBUG=false
APP_URL=https://admin.mcbtsi.com            # update after the subdomain A record is set

# --- Security ---
SESSION_SECURE_COOKIE=true
# Real proxy IPs/CIDRs ONLY (never '*' — it defeats login throttling).
TRUSTED_PROXIES=

# --- Database: SQLite (dev) -> MySQL (prod) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=admin_system
DB_USERNAME=admin_system
DB_PASSWORD=

# --- Session / queue / cache (all follow the DB connection) ---
SESSION_DRIVER=database
QUEUE_CONNECTION=database    # webhook job; worker via cron `queue:work --stop-when-empty`
CACHE_STORE=database
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Mail: cPanel mailbox SMTP (verification/reset + weekly digest must send) ---
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=mail.mcbtsi.com
MAIL_PORT=587
MAIL_USERNAME=admin@mcbtsi.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@mcbtsi.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- monday.com integration ---
# Global kill-switch: false = no new-item pull anywhere (webhook + delta scan).
# Flip to true ONLY after a connected board + per-table toggle are set and a
# `monday:sync <domain> --dry-run` passes.
MONDAY_SYNC_ENABLED=false
MONDAY_API_TOKEN=
MONDAY_TRANSPORT=delta        # delta (scheduled) until webhooks are registered, then webhook
# Board ids (from the board URLs) — used by inspect/sync commands.
MONDAY_TICKETS_BOARD_ID=5028514175
MONDAY_PDB_BOARD_ID=5028296070
MONDAY_REPORTS_BOARD_ID=5028606690

# --- Timezone (make the digest + scheduler fire at the intended local time) ---
# APP_TIMEZONE=Asia/Manila

# --- Registration stays disabled (internal workspace) ---
ALLOW_REGISTRATION=false
